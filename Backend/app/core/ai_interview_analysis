import os
import json
import google.generativeai as genai
from dotenv import load_dotenv

load_dotenv()
genai.configure(api_key=os.getenv("GEMINI_API_KEY"))

model = genai.GenerativeModel("models/gemini-2.5-flash")


def analyze_interview(transcript: str, voice_score: int):
    prompt = f"""
You are an AI hiring analyst.

Interview Transcript:
{transcript}

Voice Score: {voice_score}

Analyze and return ONLY JSON:
{{
  "strengths": "2-3 bullet points",
  "weaknesses": "2-3 bullet points",
  "recommendation": "Hire / Hold / Reject with reason"
}}
"""

    response = model.generate_content(
        prompt,
        generation_config={
            "temperature": 0.2,
            "response_mime_type": "application/json"
        }
    )

    return json.loads(response.text)